# Copy the shape of /docker/traefik/dynamic/rakazo.yml.
# Do not edit rakazo.yml. Write this as a new file, for example
# /docker/traefik/dynamic/kili.yml, only after Kili is listening on 127.0.0.1:8765.
http:
  routers:
    kili:
      rule: Host(`kili.lork.cloud`)
      entryPoints:
        - websecure
      tls:
        certResolver: letsencrypt
      service: kili
  services:
    kili:
      loadBalancer:
        servers:
          - url: http://127.0.0.1:8765
