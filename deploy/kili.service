[Unit]
Description=Kili gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kili
Group=kili
WorkingDirectory=/opt/kili/src
EnvironmentFile=/opt/kili/data/kili.env
ExecStart=/opt/kili/venv/bin/nanobot gateway --foreground --config /opt/kili/data/config.json --workspace /opt/kili/data/workspace
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
